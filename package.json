{
  "name": "mathdefendergame",
  "version": "1.5.0",
  "description": "Defend your base from falling meteors by solving math problems.",
  "license": "ISC",
  "author": "Stanislav Spuzyak",
  "main": "electron/main.ts",
  "type": "module",
  "scripts": {
    "dev:web": "vite",
    "dev:web:mobile": "vite --host 0.0.0.0 --port 5173",
    "dev:electron": "concurrently -k \"npm:dev:web\" \"wait-on http://localhost:5173 && electron . --renderer-url=http://localhost:5173\"",
    "flags:manager": "node tools/feature-flags/server.mjs",
    "start:electron": "electron .",
    "start:electron:debug": "electron . --inspect",
    "test:ui": "vitest --ui --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "test:all": "vitest run --config vitest.config.ts",
    "test:all:coverage": "vitest run --coverage --config vitest.config.ts",
    "test:electron": "vitest run --config vitest.config.ts --project=electron",
    "test:platform": "vitest run --config vitest.config.ts --project=platform",
    "test:store": "vitest run --config vitest.config.ts --project=store",
    "test:phaser": "vitest run --config vitest.config.ts --project=phaser --project=platform --project=store",
    "test:react": "vitest run --config vitest.config.ts --project=react --project=platform --project=store",
    "test:storybook": "vitest run --config vitest.config.ts --project=storybook",
    "skill:smoke": "node scripts/skill-smoke.mjs",
    "skill:bench": "node scripts/skill-benchmark.mjs",
    "skill:bench:ci": "node scripts/skill-benchmark.mjs --ci",
    "build:web:e2e": "vite build --mode e2e",
    "preview:web:mobile": "vite preview --host 0.0.0.0 --port 4173",
    "build:e2e": "npm run build:web:e2e && electron-builder --dir",
    "test:e2e": "playwright test",
    "test:e2e:web": "playwright test --project=web-mobile-portrait --project=web-mobile-landscape",
    "test:e2e:electron": "playwright test --project=electron-ui --project=electron-game --project=electron-integration --project=electron-smoke --project=electron-visual",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:update-snapshots": "playwright test --project=electron-visual --update-snapshots",
    "lint": "eslint src --ext .ts,.tsx --max-warnings 0",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "lint:report": "npm run lint:report:html && npm run lint:report:json",
    "lint:report:html": "eslint src --ext .ts,.tsx -f html -o reports/eslint-report.html || exit 0",
    "lint:report:json": "eslint src --ext .ts,.tsx -f json -o reports/eslint-report.json || exit 0",
    "typecheck": "tsc --noEmit",
    "types:coverage": "type-coverage --detail",
    "quality:unused": "knip",
    "quality:all": "npm run lint && npm run typecheck && npm run test:all:coverage && npm run types:coverage && npm run quality:unused",
    "deps:audit": "npm audit",
    "deps:audit:ci": "npm audit --audit-level=high",
    "deps:signatures": "npm audit signatures",
    "deps:outdated": "npm outdated --long",
    "deps:unused": "knip --dependencies",
    "build:web": "npm run test:all && npm run typecheck && vite build",
    "build:win": "rm -Rf ./dist/ && npm run build:web && electron-builder",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "release:guard": "node .github/skills/release-workflow/scripts/release-guard.mjs",
    "release:report:build": "node .github/skills/release-workflow/scripts/build-prod-report.mjs",
    "docs:sync-current-stack": "node tools/sync-current-stack.mjs",
    "changelog": "conventional-changelog -p conventionalcommits -i CHANGELOG.md -s -r 0",
    "git:commit": "git add . && git commit -m \"build: bump up to a new version\"",
    "git:push": "git push origin master && git push --tags",
    "which:version": "npx conventional-recommended-bump -p conventionalcommits",
    "release:commit": "npm run changelog && npm run git:commit && npm run git:push",
    "prerelease:major": "npm run release:guard",
    "release:major": "npm version major && npm run release:commit",
    "prerelease:minor": "npm run release:guard",
    "release:minor": "npm version minor && npm run release:commit",
    "prerelease:patch": "npm run release:guard",
    "release:patch": "npm version patch && npm run release:commit"
  },
  "dependencies": {
    "i18next": "^26.7.2",
    "i18next-browser-languagedetector": "^8.3.0",
    "phaser": "^4.2.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.13",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.6.0",
    "@eslint-react/eslint-plugin": "^5.28.8",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.1",
    "@storybook/addon-a11y": "^10.6.5",
    "@storybook/addon-docs": "^10.6.5",
    "@storybook/addon-onboarding": "^10.6.5",
    "@storybook/addon-vitest": "^10.6.5",
    "@storybook/react-vite": "^10.6.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/browser-playwright": "^5.1.0",
    "@vitest/coverage-v8": "^5.1.0",
    "@vitest/ui": "^5.1.0",
    "clsx": "^2.1.1",
    "concurrently": "^10.0.6",
    "conventional-changelog": "^8.1.3",
    "conventional-changelog-conventionalcommits": "^10.4.1",
    "conventional-recommended-bump": "^12.1.1",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "happy-dom": "^21.0.4",
    "jsdom": "^29.1.1",
    "knip": "^6.44.1",
    "playwright": "^1.64.1",
    "sass": "^1.107.1",
    "storybook": "^10.6.5",
    "type-coverage": "^2.31.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^5.1.0",
    "vitest-canvas-mock": "^1.2.0",
    "wait-on": "^9.5.1"
  },
  "build": {
    "appId": "com.iwestpole.mathdefendergame",
    "win": {
      "target": "nsis"
    },
    "files": [
      "build/**/*",
      "!build/README.md",
      "electron/**/*",
      "package.json"
    ]
  }
}

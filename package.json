{
  "name": "mathdefendergame",
  "version": "1.0.1",
  "description": "The player defends a base from falling meteors containing math expressions by typing the correct answer and pressing Enter. The game features a progression system, difficulty levels, and a persistent leaderboard.",
  "license": "ISC",
  "author": "Stanislav Spuzyak",
  "main": "electron/main.js",
  "scripts": {
    "dev:web": "vite",
    "dev:electron": "concurrently -k \"npm:dev:web\" \"wait-on http://localhost:5173 && electron . --renderer-url=http://localhost:5173\"",
    "start:electron": "electron .",
    "start:electron:debug": "electron . --inspect",
    "test:ui": "vitest --ui --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "test:all": "vitest run --config vitest.config.ts",
    "test:all:coverage": "vitest run --coverage --config vitest.config.ts",
    "test:electron": "vitest run --config vitest.config.ts --project=electron",
    "test:phaser": "vitest run --config vitest.config.ts --project=phaser",
    "test:react": "vitest run --config vitest.config.ts --project=react",
    "test:storybook": "vitest run --config vitest.config.ts --project=storybook",
    "build:web:e2e": "vite build --mode e2e",
    "build:e2e": "npm run build:web:e2e && electron-builder --dir",
    "test:e2e": "npm run build:e2e && playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:update-snapshots": "npm run build:e2e && playwright test e2e/visual --update-snapshots",
    "lint": "eslint src --ext .ts,.tsx --max-warnings 0",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "lint:report": "npm run lint:report:html && npm run lint:report:json",
    "lint:report:html": "eslint src --ext .ts,.tsx -f html -o reports/eslint-report.html || exit 0",
    "lint:report:json": "eslint src --ext .ts,.tsx -f json -o reports/eslint-report.json || exit 0",
    "typecheck": "tsc --noEmit",
    "types:coverage": "type-coverage --detail",
    "quality:unused": "knip",
    "quality:all": "npm run lint && npm run typecheck && npm run test:all:coverage && npm run types:coverage && npm run quality:unused",
    "deps:audit": "npm audit",
    "deps:audit:ci": "audit-ci",
    "deps:outdated": "npm outdated --long",
    "deps:unused": "knip",
    "deps:check-updates": "npx npm-check-updates",
    "build:web": "npm run test:all && npm run typecheck && vite build",
    "build:win": "npm run build:web && electron-builder",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "release:guard": "node scripts/release-guard.mjs",
    "changelog": "conventional-changelog -p conventionalcommits -i CHANGELOG.md -s -r 0",
    "git:commit": "git add . && git commit -m \"build: bump up to a new version\"",
    "git:push": "git push origin master && git push --tags",
    "which:version": "npx conventional-recommended-bump -p conventionalcommits",
    "release:commit": "npm run changelog && npm run git:commit && npm run git:push",
    "prerelease:major": "npm run release:guard",
    "release:major": "npm version major && npm run release:commit",
    "prerelease:minor": "npm run release:guard",
    "release:minor": "npm version minor && npm run release:commit",
    "prerelease:patch": "npm run release:guard",
    "release:patch": "npm version patch && npm run release:commit"
  },
  "dependencies": {
    "phaser": "^4.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.2.1",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.62.1",
    "@storybook/addon-a11y": "^10.4.6",
    "@storybook/addon-docs": "^10.4.6",
    "@storybook/addon-onboarding": "^10.4.6",
    "@storybook/addon-vitest": "^10.4.6",
    "@storybook/react-vite": "^10.4.6",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.0.4",
    "@vitest/browser-playwright": "^4.1.10",
    "@vitest/coverage-v8": "^4.1.9",
    "@vitest/ui": "^4.1.9",
    "clsx": "^2.1.1",
    "concurrently": "^10.0.3",
    "conventional-changelog": "^8.1.0",
    "conventional-changelog-conventionalcommits": "^10.2.1",
    "conventional-recommended-bump": "^12.1.0",
    "electron": "^42.5.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "happy-dom": "^20.11.0",
    "jsdom": "^29.1.1",
    "playwright": "^1.62.1",
    "sass": "^1.102.0",
    "storybook": "^10.4.6",
    "type-coverage": "^2.29.7",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.64.0",
    "vite": "^8.1.0",
    "vitest": "^4.1.9",
    "vitest-canvas-mock": "^1.1.4",
    "wait-on": "^9.0.10",
    "audit-ci": "^7.1.0",
    "knip": "^5.68.2",
    "npm-check-updates": "^18.3.0"
  },
  "build": {
    "appId": "com.iwestpole.mathdefendergame",
    "win": {
      "target": "nsis"
    },
    "files": [
      "build/**/*",
      "!build/README.md",
      "electron/**/*",
      "package.json"
    ]
  }
}

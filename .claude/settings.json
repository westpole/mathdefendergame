{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run lint:*)",
      "Bash(npm run typecheck)",
      "Bash(npm run types:coverage)",
      "Bash(npm run test:*)",
      "Bash(npm run skill:*)",
      "Bash(npm run which:version)",
      "Bash(npm run docs:sync-current-stack:*)",
      "Bash(npm list:*)",
      "Bash(npm explain:*)",
      "Bash(npm outdated:*)",
      "Bash(npm view:*)",
      "Bash(npm run deps:audit:*)",
      "Bash(npm run deps:outdated)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch --show-current)",
      "Bash(git rev-parse:*)"
    ],
    "ask": [
      "Bash(npm install:*)",
      "Bash(npm ci:*)",
      "Bash(npm version:*)",
      "Bash(npm run build:*)",
      "Bash(npm run release:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git tag:*)"
    ],
    "deny": [
      "Bash(npm *--force*)",
      "Bash(npm *--legacy-peer-deps*)",
      "Bash(npm update:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Read(./.env)",
      "Read(./.env.*)"
    ]
  }
}
